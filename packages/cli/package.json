{
  "name": "reppit",
  "version": "0.1.0",
  "description": "reppit: find the community's top repo or skill for your problem from the terminal.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "reppit": "./dist/index.js"
  },
  "files": [
    "dist",
    "checksums.json",
    "platforms.json"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/index.ts",
    "test": "vitest run --passWithNoTests",
    "prepack": "node ../../scripts/verify-cli-release.mjs && pnpm build"
  },
  "optionalDependencies": {
    "reppit-cli-darwin-arm64": "0.1.0",
    "reppit-cli-darwin-x64": "0.1.0",
    "reppit-cli-linux-arm64": "0.1.0",
    "reppit-cli-linux-x64": "0.1.0",
    "reppit-cli-win32-x64": "0.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "vitest": "^3.0.0"
  }
}
