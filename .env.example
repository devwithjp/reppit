# Leave DATABASE_URL unset to use embedded PGlite (dev/test). Set for real Postgres with pgvector.
# DATABASE_URL=postgres://gitit:gitit@localhost:5432/gitit

# Optional. Without it caching is in-memory.
# REDIS_URL=redis://localhost:6379

# GitHub OAuth app (https://github.com/settings/developers). Without these, a dev-only login is enabled.
# GITHUB_ID=
# GITHUB_SECRET=
AUTH_SECRET=change-me-in-production
AUTH_URL=http://localhost:3100

# GitHub token for ingestion (raises rate limits from 60 to 5000 req/h).
# GITHUB_TOKEN=

# Embeddings. Provider: openai | voyage | local. "local" is a deterministic hashing embedder for dev/tests.
# gte-small runs locally with no key (default). "local" is a hashing embedder for tests only.
EMBEDDING_PROVIDER=gte-small
# OPENAI_API_KEY=
# VOYAGE_API_KEY=

# LLM for the one-line "why" explanations. Unset = template-based explanations.
# ANTHROPIC_API_KEY=

# Public URL the MCP server and CLI call.
GITIT_API_URL=http://localhost:3100
