{
  "name": "@gitit/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/local-next.ts dev",
    "build": "next build",
    "start": "next start -p 3100",
    "start:local": "tsx scripts/local-next.ts start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "seed": "tsx scripts/seed.ts",
    "refresh:skills": "tsx scripts/seed-skills.ts",
    "refresh:repos": "tsx scripts/backfill.ts --existing --stale 20",
    "eval": "tsx scripts/eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.0",
    "@electric-sql/pglite": "^0.3.0",
    "@gitit/core": "workspace:*",
    "@gitit/db": "workspace:*",
    "@huggingface/transformers": "3.7.5",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "drizzle-orm": "^0.44.0",
    "next": "^15.3.0",
    "pg": "^8.13.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
